PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shift24?retryWrites=true&w=majority
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
CLIENT_URL=https://your-frontend.vercel.app

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@shift24.com
DEFAULT_ADMIN_PASSWORD=your_admin_password_here
ADMIN_KEY=shift24admin

# Email Delivery Configuration (Nodemailer / SMTP)
# Option A: Gmail (Recommended for quick setup with a 16-character App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password

# Option B: Custom SMTP Server
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_pass
# SMTP_FROM="SHIFT24 Nutrition" <noreply@shift24.food>
